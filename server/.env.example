PORT=3000

# ── PostgreSQL (Railway: add Postgres plugin, copy DATABASE_URL) ───────────
DATABASE_URL=postgresql://user:pass@host:5432/railway
PGSSL=false

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=30d
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
MAX_OTP_ATTEMPTS=5

# ── SMS / OTP provider ─────────────────────────────────────────────────────
# Options: console | kavenegar | smsir
SMS_PROVIDER=console
DEV_OTP_RESPONSE=true

# Kavenegar (https://kavenegar.com)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=boma

# SMS.ir (https://sms.ir)
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=

# ── Admin panel (/admin) ───────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_JWT_SECRET=

# ── Force update (same as before) ──────────────────────────────────────────
MIN_BUILD_NUMBER=1
LATEST_BUILD_NUMBER=1
LATEST_VERSION=1.0.0
FORCE_UPDATE=true
UPDATE_MESSAGE=نسخه جدید بوما منتشر شده. برای ادامه، اپ را به‌روزرسانی کنید.
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.boma.app
IOS_STORE_URL=https://apps.apple.com/app/id0000000000
